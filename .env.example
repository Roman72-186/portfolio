# Database
DATABASE_URL=postgresql://portfolio:secret@db:5432/portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=secret
POSTGRES_DB=portfolio

# App
SESSION_SECRET=change-me-generate-random-32-chars
PII_ENCRYPTION_SECRET=change-me-separate-pii-secret
SESSION_TTL_HOURS=24
ONE_TIME_LINK_TTL_MINUTES=30
INTERNAL_API_TOKEN=change-me-internal-token
COURSE_CALCULATOR_ALL_ROLES=false  # true: full calculator on login page + widget for all logged-in users

# Bunny Stream pilot video
# BUNNY_STREAM_TOKEN_KEY is private. Set it only in the server environment.
BUNNY_STREAM_ENABLED=false
BUNNY_STREAM_LIBRARY_ID=720058
BUNNY_STREAM_VIDEO_ID=35ed80ae-8103-4528-a700-3f69ec56957d
BUNNY_STREAM_TOKEN_KEY=change-me-bunny-token-key
BUNNY_STREAM_API_KEY=change-me-bunny-stream-api-key
BUNNY_STREAM_TOKEN_TTL_SECONDS=300
BUNNY_STREAM_VIDEO_TITLE=Тестовый видеоурок

# Redis
# Optional: set both values to run Redis with password authentication.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# Google Drive (for n8n folder navigation)
GOOGLE_DRIVE_PARENT_ID=1fb5GyudhpI013B4EQsZ6nzOoxVRtfn1g

# n8n upload webhook
N8N_ENABLED=false
N8N_BASE_URL=https://n8n-new.twc1.net
N8N_WEBHOOK_UPLOAD=https://n8n-new.twc1.net/webhook/TMEog8ATVv9CW6xh/webhook/portfolio-upload
N8N_WEBHOOK_SECRET=change-me-shared-webhook-secret

# Domain
DOMAIN=apparchi.ru
SSL_EMAIL=admin@example.com

# VK OAuth
VK_APP_ID=your_vk_app_id
VK_APP_SECRET=your_vk_app_secret
VK_REDIRECT_URI=https://apparchi.ru/auth/vk/callback
VK_GROUP_ID=123456

# S3 (TimeWeb сейчас, Selectel — после миграции)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=ru-1
# true — TimeWeb (публичность через Object ACL на каждый объект)
# false — Selectel (Object ACL не поддерживает, публичность через тип бакета / bucket policy)
S3_USE_ACL=true
